{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Debug package — control-theory-exps",
      "type": "python",
      "request": "launch",
      "module": "playground_package",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Debug with uv",
      "type": "python",
      "request": "launch",
      "module": "uv",
      "args": [
        "run",
        "playground-package"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
