{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Debug package — control-theory-exps",
      "type": "python",
      "request": "launch",
      "module": "playground_package",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Debug with uv",
      "type": "python",
      "request": "launch",
      "module": "uv",
      "args": [
        "run",
        "playground-package"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Streamlit: Debug app",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "${workspaceFolder}/src/playground_package/streamlit_app/main.py",
        "--server.runOnSave",
        "true"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        // Also makes Streamlit reload edited modules under src/, not only the page scripts
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
